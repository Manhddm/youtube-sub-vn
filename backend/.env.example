# ==================== CHẾ ĐỘ CHẠY FREE & LOCAL 100% ====================
# Không cần điền GEMINI_API_KEY khi dùng TRANSLATION_PROVIDER=local và TTS_PROVIDER=edge
TRANSLATION_PROVIDER=local
TTS_PROVIDER=edge

# ==================== CẤU HÌNH DỊCH LOCAL (CTranslate2 + Whisper) ====================
# Lựa chọn 1 (Nhanh nhất, nhẹ ~300MB): Helsinki-NLP/opus-mt-en-vi
# Lựa chọn 2 (Dịch tiếng Việt mượt hơn): vinai/vinai-translate-en2vi-v2
LOCAL_MT_MODEL=Helsinki-NLP/opus-mt-en-vi
LOCAL_MT_BEAM=1
LOCAL_MT_BATCH=64
LOCAL_MT_MAX_LENGTH=512

# Cấu hình nhận diện giọng nói khi video không có sẵn phụ đề tiếng Anh
LOCAL_WHISPER_MODEL=base.en
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_CACHE_DIR=

# ==================== CẤU HÌNH GIỌNG ĐỌC (Edge-TTS Free) ====================
# Các mẫu giọng có thể chọn mặc định (hoặc chỉnh trực tiếp trên Popup Extension):
# - vi-VN-NamMinhNeural (Giọng Nam chuẩn)
# - vi-VN-HoaiMyNeural (Giọng Nữ chuẩn)
# - vi-VN-NamMinhNeural|pitch=-10Hz (Giọng Nam trầm)
# - vi-VN-HoaiMyNeural|pitch=+8Hz (Giọng Nữ cao)
EDGE_VOICE=vi-VN-NamMinhNeural
EDGE_TTS_ATTEMPTS=5

# ==================== CẤU HÌNH STREAMING & HIỆU NĂNG ====================
STREAM_CHUNK_SECONDS=15
MAX_PROGRESSIVE_SECONDS=43200
STREAM_LOOKAHEAD_CHUNKS=4
STREAM_LOOKAHEAD_LOCAL_CHUNKS=12
STREAM_TTS_PARALLEL=8
TTS_PARALLEL=8
STREAM_CHUNK_ATTEMPTS=3
STREAM_CHUNK_RETRY_SECONDS=5

# ==================== GIỚI HẠN CHẾ ĐỘ CLASSIC ====================
MAX_VIDEO_SECONDS=600
MAX_UPLOAD_MB=100
CHUNK_SECONDS=90

# ==================== CẤU HÌNH GEMINI DỰ PHÒNG (TÙY CHỌN) ====================
GEMINI_API_KEY=PASTE_YOUR_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_MODEL_FALLBACKS=gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts
GEMINI_VOICE=Puck
GEMINI_ANALYSIS_TIMEOUT_SECONDS=30
GEMINI_TTS_TIMEOUT_SECONDS=20
GEMINI_RETRY_DELAY_SECONDS=2
GEMINI_RETRY_JITTER_SECONDS=1