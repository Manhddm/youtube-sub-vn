# Copy this file to .env and replace the API key.
# Get a free-tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=PASTE_YOUR_API_KEY_HERE

# Main model processes audio/video and returns timestamped Vietnamese cues.
# Fallbacks are tried in order when a model is overloaded, missing or times out.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash

# Edge TTS is the practical default: keyless, ~5x faster per chunk, no Gemini
# TTS quota. It is an unofficial online service. For a more natural Gemini
# voice set TTS_PROVIDER=gemini (usually slower than realtime on the free tier).
TTS_PROVIDER=edge
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_MODEL_FALLBACKS=gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts
GEMINI_VOICE=Puck
EDGE_VOICE=vi-VN-NamMinhNeural

# Per-model call budgets in seconds; a failed model moves to the next candidate.
GEMINI_ANALYSIS_TIMEOUT_SECONDS=30
GEMINI_TTS_TIMEOUT_SECONDS=20
GEMINI_RETRY_DELAY_SECONDS=2
GEMINI_RETRY_JITTER_SECONDS=1

# Classic full-video mode limits.
MAX_VIDEO_SECONDS=600
MAX_UPLOAD_MB=100
CHUNK_SECONDS=90

# Progressive mode: small chunks allow playback before the whole video is dubbed.
STREAM_CHUNK_SECONDS=20
MAX_PROGRESSIVE_SECONDS=43200
STREAM_LOOKAHEAD_CHUNKS=4
# Parallel speech requests inside one chunk (1 = sequential).
STREAM_TTS_PARALLEL=4
# Retries for one failed chunk before the job reports an error.
STREAM_CHUNK_ATTEMPTS=3
STREAM_CHUNK_RETRY_SECONDS=5
